APP_NAME=Starton API
# Replace USERNAME, PASSWORD, HOST, and DATABASE with your real RDS values.
# URL-encode special password characters such as @, :, /, #, and %.
DATABASE_URL=mysql+asyncmy://USERNAME:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set a long random value on the API server and Raspberry Pi devices.
DEVICE_API_KEY=replace-with-a-long-random-device-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
# Generate with: python -m py_vapid --applicationServerKey
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
