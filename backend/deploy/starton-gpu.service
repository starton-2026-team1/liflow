[Unit]
Description=Starton Gemma GPU inference server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/starton/backend
EnvironmentFile=/home/ubuntu/starton/backend/.env.gpu
ExecStart=/home/ubuntu/starton/backend/.venv-gpu/bin/uvicorn gpu_inference.main:app --host 0.0.0.0 --port 9000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
